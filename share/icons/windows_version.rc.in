// Generated from windows_version.rc.in by CMake configure_file (@ONLY).
// Stamps the Windows executable VERSIONINFO from the single version source of truth (version.cmake -> MUSE_APP_VERSION).

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @MUSE_APP_VERSION_MAJOR@,@MUSE_APP_VERSION_MINOR@,@MUSE_APP_VERSION_PATCH@,0
    PRODUCTVERSION @MUSE_APP_VERSION_MAJOR@,@MUSE_APP_VERSION_MINOR@,@MUSE_APP_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MuseScore Limited"
            VALUE "FileDescription",  "@MUSE_APP_NAME_HUMAN_READABLE@"
            VALUE "FileVersion",      "@MUSE_APP_VERSION@"
            VALUE "InternalName",     "@MUSE_APP_NAME_MACHINE_READABLE@"
            VALUE "LegalCopyright",   "Copyright (C) 1999-2026 MuseScore Limited and others. Reprise additions (C) 2026 The Reprise contributors. Published under the GNU GPL v3."
            VALUE "OriginalFilename", "@MUSE_APP_NAME_MACHINE_READABLE@.exe"
            VALUE "ProductName",      "@MUSE_APP_NAME_HUMAN_READABLE@"
            VALUE "ProductVersion",   "@MUSE_APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
